#include "cache.h"

// Stride Pattern Prefetcher (SPP), built on the IP-stride prefetcher (ip_stride.l1d_pref).
// - Uniform strides: same as IP-stride, but has a confidence counter.
// - Non-uniform strides: a per-IP signature (the last 3 strides, 4 bits each) indexes a
//   shared pattern table that stores the stride that followed that signature.
// - Accuracy-based throttling, with a separate degree for uniform and pattern mode.

#define IP_TRACKER_COUNT 64     // 24 (as in IP-stride) was too small: Trace3 needs ~64
#define MASK_IP 0xFF

#define UNIFORM_THRESH 2        // uniform mode when the stride repeated this many times in a row
#define CONF_MAX 3              // 2-bit saturating counters

#define SIG_BITS 12             // 3 strides x 4 bits
#define SIG_MASK ((1 << SIG_BITS) - 1)
#define PT_SIZE (1 << SIG_BITS) // 4096 entries
#define PT_THRESH 1             // minimum pattern table confidence to issue a prefetch
#define SIG_STRIDE_MIN -8       // strides that fit in 4 bits (two's complement)
#define SIG_STRIDE_MAX 7

// throttling: each mode has its own degree, set by its own accuracy (useful / filled into L1D)
// every EPOCH_FILLS fills the degree moves one level: up if accuracy >= ACC_UP, down if < ACC_DOWN
// moving one level at a time stops the degree from jumping back and forth every epoch
#define EPOCH_FILLS 64          // re-evaluate a mode after this many of its prefetches fill L1D
#define ACC_UP   0.60
#define ACC_DOWN 0.40
#define DEG_HIGH 8
#define DEG_MID  4
#define DEG_LOW  2
#define DEG_MIN  1
#define NUM_LEVELS 4
#define START_LEVEL 2           // start at DEG_MID

// mode that issued a prefetch, stored in bits 11:8 of the metadata (ChampSim counts filled/useful per class)
#define PF_CLASS_UNIFORM 1
#define PF_CLASS_PATTERN 2
#define PF_CLASS_META(c) ((uint32_t)(c) << 8)

// keep only the low 16 bits of the last line address; the stride is the sign-extended difference
// LAST_ADDR_MODE 0 keeps the full address
#ifndef LAST_ADDR_MODE
#define LAST_ADDR_MODE 1
#endif
#ifndef LAST_ADDR_BITS
#define LAST_ADDR_BITS 16
#endif
#define LA_MASK ((1ull << LAST_ADDR_BITS) - 1)

static uint64_t encode_last(uint64_t cl_addr)
{
#if LAST_ADDR_MODE == 1
    return cl_addr & LA_MASK;
#else
    return cl_addr;
#endif
}

class IP_TRACKER {
  public:
    // the IP we're tracking
    uint64_t ip;

    // the last address accessed by this IP (low 16 bits only)
    uint64_t last_cl_addr;

    // the stride between the last two addresses accessed by this IP
    int64_t last_stride;

    // use LRU to evict old IP trackers
    uint32_t lru;

    // how many times in a row the stride repeated (uniform confidence)
    uint32_t conf;

    // the last 3 strides of this IP, 4 bits each (0 = no history)
    uint32_t sig;

    IP_TRACKER () {
        ip = 0;
        last_cl_addr = 0;
        last_stride = 0;
        lru = 0;
        conf = 0;
        sig = 0;
    };
};

class PT_ENTRY {
  public:
    // the stride that followed this signature
    int64_t next_stride;

    // how reliable that stride has been
    uint32_t conf;

    PT_ENTRY () {
        next_stride = 0;
        conf = 0;
    };
};

IP_TRACKER trackers[IP_TRACKER_COUNT];
PT_ENTRY pattern_table[PT_SIZE];

// throttling state per mode (1 = uniform, 2 = pattern)
static const uint32_t LEVELS[NUM_LEVELS] = {DEG_MIN, DEG_LOW, DEG_MID, DEG_HIGH};
uint32_t mode_level[3]  = {0, START_LEVEL, START_LEVEL};
uint32_t mode_degree[3] = {0, DEG_MID, DEG_MID};
uint64_t mode_ep_filled[3] = {0}, mode_ep_useful[3] = {0};   // counters at the start of the epoch

// stats for the report
uint64_t uniform_pf = 0, pattern_pf = 0;
uint64_t mode_epochs[3] = {0}, mode_changes[3] = {0};
uint64_t mode_epochs_at_degree[3][DEG_HIGH+1] = {{0}};

// per-mode counters at the end of warmup (ChampSim does not reset them)
bool roi_snapshot_taken = false;
uint64_t roi_filled_base[3] = {0}, roi_useful_base[3] = {0};

static uint32_t update_sig(uint32_t sig, int64_t stride)
{
    return ((sig << 4) | (stride & 0xF)) & SIG_MASK;
}

static bool fits_sig(int64_t stride)
{
    return stride >= SIG_STRIDE_MIN && stride <= SIG_STRIDE_MAX;
}

void CACHE::l1d_prefetcher_initialize()
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
	for (int i=0; i<IP_TRACKER_COUNT; i++)
        	trackers[i].lru = i;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
	// check for a tracker hit
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    ip = ip & MASK_IP;

    int index = -1;
    for (index=0; index<IP_TRACKER_COUNT; index++) {
        if (trackers[index].ip == ip)
            break;
    }

    // this is a new IP that doesn't have a tracker yet, so allocate one
    if (index == IP_TRACKER_COUNT) {

        for (index=0; index<IP_TRACKER_COUNT; index++) {
            if (trackers[index].lru == (IP_TRACKER_COUNT-1))
                break;
        }

        trackers[index].ip = ip;
        trackers[index].last_cl_addr = encode_last(cl_addr);
        trackers[index].last_stride = 0;
        trackers[index].conf = 0;
        trackers[index].sig = 0;

	    for (int i=0; i<IP_TRACKER_COUNT; i++) {
            if (trackers[i].lru < trackers[index].lru)
                trackers[i].lru++;
        }
        trackers[index].lru = 0;

        return; //metadata_in;
    }

	// sanity check
    // at this point we should know a matching tracker index
    if (index == -1)
        assert(0);

    // calculate the stride between the current address and the last address
    // this bit appears overly complicated because we're calculating
    // differences between unsigned address variables
    int64_t stride = 0;
#if LAST_ADDR_MODE == 1
    {
        uint64_t d = (encode_last(cl_addr) - trackers[index].last_cl_addr) & LA_MASK;
        stride = (d & (1ull << (LAST_ADDR_BITS - 1))) ? (int64_t)d - (int64_t)(1ull << LAST_ADDR_BITS) : (int64_t)d;
    }
#else
    if (cl_addr > trackers[index].last_cl_addr)
        stride = cl_addr - trackers[index].last_cl_addr;
    else {
        stride = trackers[index].last_cl_addr - cl_addr;
        stride *= -1;
    }
#endif

    // don't do anything if we somehow saw the same address twice in a row
    if (stride == 0)
        return;	//metadata_in;

    // uniform confidence: count repeats, reset when the stride changes
    if (stride == trackers[index].last_stride) {
        if (trackers[index].conf < CONF_MAX)
            trackers[index].conf++;
    } else
        trackers[index].conf = 0;

    // train the pattern table: the old signature was followed by this stride
    uint32_t sig = trackers[index].sig;
    if (sig != 0 && fits_sig(stride)) {
        PT_ENTRY &e = pattern_table[sig];
        if (e.next_stride == stride) {
            if (e.conf < CONF_MAX)
                e.conf++;
        } else if (e.conf > 0)
            e.conf--;
        else {
            e.next_stride = stride;
            e.conf = 1;
        }
    }

    // update the signature with this stride (strides that don't fit reset the history)
    trackers[index].sig = fits_sig(stride) ? update_sig(sig, stride) : 0;

    if (trackers[index].conf >= UNIFORM_THRESH) {

        // uniform stride: prefetch like IP-stride
        for (uint32_t i=0; i<mode_degree[PF_CLASS_UNIFORM]; i++) {
            uint64_t pf_address = (cl_addr + (stride*(i+1))) << LOG2_BLOCK_SIZE;

            // only issue a prefetch if the prefetch address is in the same 4 KB page
            // as the current demand access address
            if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                break;

            // check the MSHR occupancy to decide if we're going to prefetch to the L1 or L2
            int ok;
            if (MSHR.occupancy < (MSHR.SIZE>>1))
              ok = prefetch_line(ip, addr, pf_address, FILL_L1, PF_CLASS_META(PF_CLASS_UNIFORM));
            else
              ok = prefetch_line(ip, addr, pf_address, FILL_L2, PF_CLASS_META(PF_CLASS_UNIFORM));
            uniform_pf += ok;
        }
    } else if (trackers[index].sig != 0) {

        // non-uniform stride: walk the pattern table from the current signature
        uint32_t walk_sig = trackers[index].sig;
        uint64_t pf_cl = cl_addr;
        for (uint32_t i=0; i<mode_degree[PF_CLASS_PATTERN]; i++) {
            PT_ENTRY &e = pattern_table[walk_sig];
            if (e.conf < PT_THRESH)
                break;

            pf_cl += e.next_stride;
            uint64_t pf_address = pf_cl << LOG2_BLOCK_SIZE;

            if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                break;

            int ok;
            if (MSHR.occupancy < (MSHR.SIZE>>1))
              ok = prefetch_line(ip, addr, pf_address, FILL_L1, PF_CLASS_META(PF_CLASS_PATTERN));
            else
              ok = prefetch_line(ip, addr, pf_address, FILL_L2, PF_CLASS_META(PF_CLASS_PATTERN));
            pattern_pf += ok;

            // pretend the predicted stride happened and predict the next one
            walk_sig = update_sig(walk_sig, e.next_stride);
        }
    }

    trackers[index].last_cl_addr = encode_last(cl_addr);
    trackers[index].last_stride = stride;

    for (int i=0; i<IP_TRACKER_COUNT; i++) {
        if (trackers[i].lru < trackers[index].lru)
            trackers[i].lru++;
    }
    trackers[index].lru = 0;

    if (!roi_snapshot_taken && warmup_complete[cpu]) {
        for (int c=PF_CLASS_UNIFORM; c<=PF_CLASS_PATTERN; c++) {
            roi_filled_base[c] = pref_filled[cpu][c];
            roi_useful_base[c] = pref_useful[cpu][c];
        }
        roi_snapshot_taken = true;
    }

    // accuracy-based throttling, per mode
    for (int c=PF_CLASS_UNIFORM; c<=PF_CLASS_PATTERN; c++) {
        uint64_t filled = pref_filled[cpu][c] - mode_ep_filled[c];
        if (filled < EPOCH_FILLS)
            continue;
        double accuracy = (double)(pref_useful[cpu][c] - mode_ep_useful[c]) / filled;

        if (accuracy >= ACC_UP && mode_level[c] < NUM_LEVELS-1)
            mode_level[c]++;
        else if (accuracy < ACC_DOWN && mode_level[c] > 0)
            mode_level[c]--;
        uint32_t new_degree = LEVELS[mode_level[c]];

        if (warmup_complete[cpu]) {
            mode_epochs[c]++;
            if (new_degree != mode_degree[c])
                mode_changes[c]++;
            mode_epochs_at_degree[c][new_degree]++;
        }
        mode_degree[c] = new_degree;
        mode_ep_filled[c] = pref_filled[cpu][c];
        mode_ep_useful[c] = pref_useful[cpu][c];
    }
    return; //metadata_in;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
	return; //metadata_in;
}

void CACHE::l1d_prefetcher_final_stats()
{
	cout << "CPU " << cpu << " L1D SPP final stats" << endl;
	cout << "SPP uniform prefetches: " << uniform_pf << " pattern prefetches: " << pattern_pf << endl;
	const char *name[3] = {"", "uniform", "pattern"};
	for (int c=1; c<=2; c++) {
		cout << "SPP " << name[c] << " epochs: " << mode_epochs[c] << " degree changes: " << mode_changes[c]
		     << " epochs at degree";
		for (int d=1; d<=DEG_HIGH; d++)
			if (d == DEG_MIN || d == DEG_LOW || d == DEG_MID || d == DEG_HIGH)
				cout << " " << d << ":" << mode_epochs_at_degree[c][d];
		cout << " final degree: " << mode_degree[c] << endl;
	}
	for (int c=1; c<=2; c++) {
		uint64_t filled = pref_filled[cpu][c] - roi_filled_base[c];
		uint64_t useful = pref_useful[cpu][c] - roi_useful_base[c];
		cout << "SPP " << name[c] << " prefetches filled into L1D: " << filled << " useful: " << useful
		     << " accuracy: " << (filled ? 100.0 * useful / filled : 0.0) << endl;
	}
}
